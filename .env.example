POSTGRES_DB=huit_library
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_local_password
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=change_this_local_password
SPRING_PROFILES_ACTIVE=default
JWT_SECRET=replace_with_at_least_32_random_characters_before_use
JWT_EXPIRATION=86400000
REFRESH_TOKEN_EXPIRATION=2592000000
QR_SECRET=replace_with_at_least_32_random_characters_before_use
QR_TTL_MINUTES=10
DATABASE_SEEDING_ENABLED=true
POSTGRES_VERSION=15-alpine
PGVECTOR_IMAGE=pgvector/pgvector:pg15
MONGO_VERSION=6-jammy
ELASTICSEARCH_VERSION=8.13.0
REDIS_VERSION=7-alpine
KAFKA_VERSION=7.6.0
NGINX_VERSION=alpine
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Mặc định Docker gửi thư vào Mailpit (http://localhost:8025). Để gửi email thật,
# thay host/port và điền tài khoản SMTP; không commit mật khẩu ứng dụng lên Git.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SSL_ENABLE=false
SPRING_MAIL_SSL_TRUST=smtp.gmail.com
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_PROVIDER=auto
RAG_TOP_K=5
RAG_MINIMUM_SCORE=0.60
RAG_MAX_INPUT_CHARACTERS=1000
RAG_CHUNK_SIZE_CHARACTERS=900
RAG_CHUNK_OVERLAP_CHARACTERS=120
RAG_CONNECT_TIMEOUT_SECONDS=5
RAG_READ_TIMEOUT_SECONDS=20
RAG_REQUESTS_PER_MINUTE=10
RAG_GENERATION_THINKING_BUDGET=0
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
# Production: prefer GOOGLE_APPLICATION_CREDENTIALS or inject this base64 value from a secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Đăng ký bộ thông tin sandbox tại https://sandbox.vnpayment.vn/devreg/
VNPAY_ENABLED=false
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/api/v1/online-payments/vnpay-return
VNPAY_FRONTEND_RESULT_URL=http://localhost:4200/my-penalties
VNPAY_EXPIRE_MINUTES=15
