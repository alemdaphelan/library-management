    AuthController --> AuthServiceImpl
    UserController --> UserServiceImpl
    LoanController --> LoanServiceImpl
    PaymentController --> PaymentServiceImpl
    ShiftController --> ShiftServiceImpl
    BookController --> BookServiceImpl
    DigitalDocController --> DigitalDocServiceImpl
