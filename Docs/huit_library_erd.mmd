    %% FULL COLUMNS ENTITY DEFINITIONS (V41 UPDATES)
    USERS {
        string user_id PK
        string role_id FK
        string password_hash
        boolean is_first_login
        string full_name
        string email
        string phone
        string user_type
        string card_status
        datetime card_expiry_date
        boolean discipline_flag
        int room_violation_count
        datetime room_lock_until
    }
    STAFF_ROLES {
        string role_id PK
        string role_name
        json permissions
    }
    WALLET {
        string wallet_id PK
        string user_id FK
        int deposit_balance
        int total_debt
        int lock_version
    }
    LOAN_TICKETS {
        string ticket_id PK
        string user_id FK
        string ticket_type
        string status
        datetime created_at
    }
    LOAN_DETAILS {
        string detail_id PK
        string ticket_id FK
        string barcode FK
        string checkout_condition_note
        string return_condition_note
        string return_status
        datetime due_date
        int renewal_count
        boolean is_recalled
        int late_fine_accrued
        datetime return_date
    }
    TRANSACTIONS {
        string transaction_id PK
        string user_id FK
        string loan_detail_id FK
        string parent_transaction_id FK
        string trans_type
        string payment_method
        int amount
        string status
        string admin_ref
        string gateway_ref
        string proof_document_url
        datetime expires_at
        datetime created_at
    }
    BOOK_COPIES {
        string barcode PK
        string book_id FK
        string status
        int cover_price
        int appraised_value
        string binding_type
        string condition_note
        string location
        string source
        datetime import_date
        datetime locked_until
        string locked_by_user FK
        int weight_grams
        string replaced_by_barcode
        int lock_version
    }
    BOOKS {
        string book_id PK
        string publisher_id FK
        string category_id FK
        string title
        int publish_year
        string language
        string label_color
        int default_price
        boolean is_digital
    }
    CATEGORIES {
        string category_id PK
        string name
        string parent_id FK
    }
    PUBLISHERS {
        string publisher_id PK
        string name
        string contact_info
    }
    AUTHORS {
        string author_id PK
        string name
        string biography
    }
    BOOK_AUTHORS {
        string book_id FK
        string author_id FK
    }
    DIGITAL_DOCUMENTS {
        string doc_id PK
        string book_id FK
        string file_url
        boolean is_open_source
        string drm_encryption_key
        int download_count
        int view_count
    }
    DIGITAL_USAGE_LOGS {
        string log_id PK
        string doc_id FK
        string user_id FK
        string ip_address
        datetime accessed_at
    }
    ROOMS {
        string room_id PK
        string room_name
        int capacity
        string facilities
        string status
    }
    ROOM_BOOKINGS {
        string booking_id PK
        string user_id FK
        string room_id FK
        datetime start_time
        datetime end_time
        datetime actual_start_time
        datetime actual_end_time
        string status
    }
    ROOM_BOOKING_MEMBERS {
        string booking_id FK
        string user_id FK
        boolean is_leader
    }
    WAITLIST {
        string waitlist_id PK
        string book_id FK
        string user_id FK
        datetime requested_at
        datetime notified_at
        datetime expires_at
        string status
    }
    NOTIFICATIONS {
        string notif_id PK
        string user_id FK
        string type
        string content
        boolean is_read
        datetime sent_at
    }
    ORIENTATION_ATTENDANCE {
        string record_id PK
        string user_id FK
        datetime attended_date
        boolean is_passed
        boolean processed
    }
    SHIFT_HANDOVER {
        string shift_id PK
        string admin_id FK
        string pos_terminal_id
        datetime start_time
        datetime end_time
        int starting_cash
        int system_revenue
        int actual_cash
        int discrepancy_amount
        string status
    }
    INVENTORY_AUDITS {
        string audit_id PK
        string admin_id FK
        datetime start_time
        datetime end_time
        string status
        int total_expected
        int total_scanned
        int total_missing
    }
    INVENTORY_DETAILS {
        string detail_id PK
        string audit_id FK
        string barcode FK
        string scan_status
        string scanned_location
    }

    %% INDEPENDENT TABLES
    AUDIT_LOGS {
        string log_id PK
        string admin_id
        string action
        string table_name
        json changes
        datetime created_at
    }
    KIOSKS {
        string kiosk_id PK
        string location_floor
        string ip_address
        string status
        datetime last_ping
    }
    SYSTEM_CONFIGS {
        string config_key PK
        string config_value
        string description
    }
    HOLIDAY_CALENDAR {
        string date_id PK
        string holiday_name
        boolean is_closed
        string override_open_time
        string override_close_time
    }
    UNIVERSITY_SYNC_LOGS {
        string log_id PK
        string endpoint
        json payload
        string sync_status
        datetime executed_at
    }
